{
  "name": "atemno",
  "version": "0.0.0",
  "private": false,
  "description": "Fine-grained local-global state management library",
  "keywords": [
    "pridepack"
  ],
  "homepage": "https://github.com/lxsmnsyc/atemno",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/atemno/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/atemno.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "prepublishOnly": "tsdown",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "tsdown": "^0.21.7",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=10"
  }
}
